APP_PORT=3001
APP_ORIGIN=http://localhost:5173
# Leave empty in same-origin production Docker deployment; set a full URL for a separate API server.
VITE_API_URL=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=knowledge_base
MYSQL_USER=root
MYSQL_PASSWORD=change-me

# Local file storage
UPLOAD_DIR=storage
MAX_UPLOAD_MB=50
PUBLIC_BASE_PATH=/knowledge-base-frontend
MAX_EMBEDDING_CANDIDATES=10000
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base_chunks
AUTH_COOKIE_NAME=kb_session
AUTH_SESSION_DAYS=14
ALLOW_REGISTRATION=true
SECURE_COOKIES=false
DEFAULT_USER_EMAIL=local@knowledge-base.dev
DEFAULT_USER_NAME=本地系统用户

# Optional OpenAI-compatible model service.
# Examples: Ollama (http://localhost:11434/v1), SiliconFlow, or another compatible gateway.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_CHAT_MODEL=openai/gpt-6-luna
AI_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=3

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base_chunks
